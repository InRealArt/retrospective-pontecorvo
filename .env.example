# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Domaine(s) du site tel que Turnstile le renvoie, séparés par des virgules (localhost en développement)
SITE_HOSTNAME=
# Brevo : chaque demande ajoute le visiteur à la liste de contacts, aucun mail n'est envoyé.
# La clé API doit avoir le droit "Contacts".
BREVO_API_KEY=
# ID de la liste Brevo (Contacts > Listes)
BREVO_CONTACTS_LIST_ID=
